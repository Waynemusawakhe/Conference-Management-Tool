        "/api/v1/conferences": {
            "get": {
                "tags": [
                    "Conferences"
                ],
                "summary": "Get all conferences",
                "operationId": "0367cf2dbc485312b0425c7bcda9ab65",
                "responses": {
                    "200": {
                        "description": "List of conferences"
                    },
                    "401": {
                        "description": "Unauthorised"
                    }
                }
            },
            "post": {
                "tags": [
                    "Conferences"
                ],
                "summary": "Create a conference",
                "operationId": "4faf8a25680c3d69e83925788e68f4e3",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "organiser_id",
                                    "code",
                                    "name",
                                    "format",
                                    "start_date",
                                    "end_date"
                                ],
                                "properties": {
                                    "organiser_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "code": {
                                        "type": "string",
                                        "example": "CMT2026"
                                    },
                                    "name": {
                                        "type": "string",
                                        "example": "CMT Annual Conference"
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Annual conference"
                                    },
                                    "category": {
                                        "type": "string",
                                        "example": "Technology"
                                    },
                                    "topics": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        },
                                        "example": [
                                            "AI",
                                            "Software Engineering"
                                        ]
                                    },
                                    "format": {
                                        "type": "string",
                                        "example": "virtual",
                                        "enum": [
                                            "in_person",
                                            "virtual",
                                            "hybrid"
                                        ]
                                    },
                                    "submission_status": {
                                        "type": "string",
                                        "example": "open",
                                        "enum": [
                                            "open",
                                            "closed"
                                        ]
                                    },
                                    "start_date": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-10-01"
                                    },
                                    "end_date": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-10-03"
                                    },
                                    "submission_deadline": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-09-01",
                                        "nullable": true
                                    },
                                    "venue_name": {
                                        "type": "string",
                                        "example": "CMT Convention Centre",
                                        "nullable": true
                                    },
                                    "city": {
                                        "type": "string",
                                        "example": "Johannesburg",
                                        "nullable": true
                                    },
                                    "country": {
                                        "type": "string",
                                        "example": "South Africa",
                                        "nullable": true
                                    },
                                    "website_link": {
                                        "type": "string",
                                        "example": "https://example.com",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Conference created successfully"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
