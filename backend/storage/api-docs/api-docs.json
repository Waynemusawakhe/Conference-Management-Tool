                ],
                "summary": "Update a conference",
                "operationId": "d987ff6d6fc7d1c11ee8f4427f9e9e9c",
                "parameters": [
                    {
                        "name": "conference",
                        "in": "path",
                        "description": "Conference ID",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "example": 1
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "code": {
                                        "type": "string",
                                        "example": "CMT2026"
                                    },
                                    "name": {
                                        "type": "string",
                                        "example": "Updated Conference Name"
                                    },
                                    "description": {
                                        "type": "string"
                                    },
                                    "category": {
                                        "type": "string"
                                    },
                                    "format": {
                                        "type": "string",
                                        "enum": [
                                            "in_person",
                                            "virtual",
                                            "hybrid"
                                        ]
                                    },
                                    "submission_status": {
                                        "type": "string",
                                        "enum": [
                                            "open",
                                            "closed"
                                        ]
                                    },
                                    "start_date": {
                                        "type": "string",
                                        "format": "date"
                                    },
                                    "end_date": {
                                        "type": "string",
                                        "format": "date"
                                    },
                                    "submission_deadline": {
                                        "type": "string",
                                        "format": "date",
                                        "nullable": true
                                    },
                                    "venue_name": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "city": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "country": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "website_link": {
                                        "type": "string",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Conference updated successfully"
                    },
                    "404": {
                        "description": "Conference not found"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            },
            "delete": {
                "tags": [
                    "Conferences"
                ],
                "summary": "Delete a conference",
                "operationId": "51691c0d397c6d6645c8b3e54ef32c1c",
                "parameters": [
                    {
                        "name": "conference",
                        "in": "path",
                        "description": "Conference ID",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "example": 1
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Conference deleted successfully"
                    },
                    "404": {
                        "description": "Conference not found"
                    }
                }
            }
        },
        "/api/v1/conferences/{conference}/status": {
            "patch": {
                "tags": [
                    "Conferences"
                ],
                "summary": "Update conference submission status",
                "operationId": "834cd1a61df61a91276ba9b2ca94dc0e",
                "parameters": [
                    {
                        "name": "conference",
                        "in": "path",
                        "description": "Conference ID",
                        "required": true,
