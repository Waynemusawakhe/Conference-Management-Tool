        "/api/v1/reviews": {
            "get": {
                "tags": [
                    "Reviews"
                ],
                "summary": "Get all reviews",
                "operationId": "5469f7cea05f9e86423254c2c778312c",
                "parameters": [
                    {
                        "name": "submission_id",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "reviewer_id",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "recommendation",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "accept",
                                "reject",
                                "revise"
                            ]
                        }
                    },
                    {
                        "name": "locked",
                        "in": "query",
                        "schema": {
                            "type": "boolean"
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 15
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of reviews"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                }
            },
            "post": {
                "tags": [
                    "Reviews"
                ],
                "summary": "Assign a reviewer to a submission",
                "operationId": "0ad7ed23b5c70e30e785412798d06d18",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "submission_id",
                                    "reviewer_id"
                                ],
                                "properties": {
                                    "submission_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "reviewer_id": {
                                        "type": "integer",
                                        "example": 1
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Reviewer assigned successfully"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "403": {
                        "description": "Forbidden"
                    },
                    "422": {
                        "description": "Validation error"
                    },
                    "409": {
                        "description": "Reviewer already assigned to this submission"
                    }
                }
            }
        },
        "/api/v1/reviews/{id}": {
            "get": {
                "tags": [
                    "Reviews"
                ],
                "summary": "Get a specific review",
                "operationId": "79bd9113a90f4125cf9bacf1a268c4b4",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Review details"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "404": {
                        "description": "Review not found"
                    }
                }
            },
            "put": {
                "tags": [
                    "Reviews"
                ],
                "summary": "Submit a review (score, comments, recommendation)",
                "operationId": "14422a74b37606d3e82e7d929736d15b",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "score",
                                    "comments",
                                    "recommendation"
                                ],
                                "properties": {
                                    "score": {
                                        "type": "integer",
                                        "example": 8
                                    },
                                    "comments": {
                                        "type": "string",
                                        "example": "Solid methodology, needs more related work."
                                    },
                                    "recommendation": {
                                        "type": "string",
                                        "example": "revise",
                                        "enum": [
                                            "accept",
                                            "reject",
                                            "revise"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Review submitted successfully"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "403": {
                        "description": "Forbidden"
                    },
                    "404": {
                        "description": "Review not found"
                    },
                    "422": {
                        "description": "Validation error or review already locked"
                    }
                }
            },
            "delete": {
                "tags": [
                    "Reviews"
                ],
                "summary": "Remove a review assignment",
                "operationId": "ffbdb4f3dac8b1ba4a86d976fc23209b",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Review assignment removed"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "403": {
                        "description": "Forbidden"
                    },
                    "404": {
                        "description": "Review not found"
                    },
                    "422": {
                        "description": "Cannot delete a submitted review"
                    }
                }
            }
        }
    },
